{
  "name": "hustling-collaborators-hrm",
  "version": "0.1.0",
  "private": true,
  "description": "Internal HRM + Task + Campaign management PWA for Hustling Collaborators",
  "license": "UNLICENSED",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "npm run build --workspace @hc/shared",
    "build:server": "npm run build --workspace @hc/server",
    "build:web": "npm run build --workspace @hc/web",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @hc/server",
    "dev:web": "npm run dev --workspace @hc/web",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm run test:domain --workspace @hc/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace @hc/server",
    "db:seed": "npm run db:seed --workspace @hc/server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
