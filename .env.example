# ─────────────────────────────────────────────────────────────────────────────
# Hustling Collaborators HRM — environment variables
# Copy to server/.env (backend) and web/.env (frontend). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server (server/.env) ─────────────────────────────────────────────────────
# Postgres (Neon / Supabase free tier). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-32-bytes-min"
REFRESH_SECRET="change-me-different-32-bytes-min"

# Shared secret the cron uses to call POST /api/v1/internal/jobs/*
JOB_SECRET="change-me-cron-bearer"

NODE_ENV="development"
PORT="4000"
# TZ is forced to UTC; all IST conversion happens in the app layer.
TZ="UTC"

# CORS: the origin the web app is served from (Vite dev or the Vercel URL).
CORS_ORIGIN="http://localhost:5173"

# Founder bootstrap for the seed script.
SEED_ADMIN_EMAIL="founder@hustlingcollaborators.com"
SEED_ADMIN_PASSWORD="change-me-strong-password"

# ── Web (web/.env) ───────────────────────────────────────────────────────────
# Base URL of the API. In dev, Vite proxies /api to the server, so this can stay relative.
VITE_API_BASE_URL="http://localhost:4000/api/v1"
